   "metadata": {},
   "source": [
    "# 🔧 Build Exercise 1.1.1 - Your First Circuit Simulation\n",
    "\n",
    "**Time Target**: 3-4 minutes  \n",
    "**Difficulty**: 🟢 Easy (Guided construction)  \n",
    "**Goal**: Build and simulate the circuit you just analyzed\n",
    "\n",
    "---\n",
    "\n",
    "## What You'll Do\n",
    "\n",
    "1. **Build** the same 9V + resistor circuit using our simulation tools\n",
    "2. **Run** a DC analysis to get the actual voltages and currents\n",
    "3. **Verify** that your prediction was correct!\n",
    "4. **Explore** what happens when you change values\n",
    "\n",
    "Let's get started! 🚀\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Setup the simulation environment\n",
    "import sys\n",
    "sys.path.append('../../../..')  # Add project root to path\n",
    "\n",
    "from circuit_sim import Circuit, SimulationEngine\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "import plotly.graph_objects as go\n",
    "import numpy as np\n",
    "\n",
    "print(\"✅ Circuit simulation tools loaded!\")\n",
    "print(\"📊 Interactive plotting ready!\")\n",
    "print(\"🎛️ Widgets enabled!\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Build Your Circuit\n",
    "\n",
    "Let's build the circuit step by step. I'll guide you through each component:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Guided circuit construction\n",
    "def create_guided_circuit_builder():\n",
    "    # Create the main circuit object\n",
    "    circuit = Circuit(\"My First Circuit\")\n",
    "    \n",
    "    # Display progress\n",
    "    progress_html = HTML(\"\"\"\n",
    "    <div style=\"background: #f8f9fa; padding: 15px; border-radius: 10px; margin: 10px 0;\">\n",
    "        <h3>🔧 Circuit Construction Progress</h3>\n",
    "        <p>Follow along as we build your circuit step by step:</p>\n",
    "        <div id=\"progress\"></div>\n",
    "    </div>\n",
    "    \"\"\")\n",
    "    display(progress_html)\n",
    "    \n",
    "    # Step 1: Add voltage source\n",
    "    print(\"Step 1: Adding 9V battery...\")\n",
    "    circuit.add_voltage_source(\"V1\", 1, 0, \"9V\")\n",
    "    print(\"✅ Battery added: 9V between node 1 (+) and node 0 (ground)\")\n",
    "    \n",
    "    # Step 2: Add resistor\n",
    "    print(\"\\nStep 2: Adding 1000Ω resistor...\")\n",
    "    circuit.add_resistor(\"R1\", 1, 0, \"1000\")\n",
    "    print(\"✅ Resistor added: 1000Ω between node 1 and ground\")\n",
    "    \n",
    "    # Step 3: Show circuit summary\n",
    "    print(\"\\n\" + \"=\"*50)\n",
    "    print(\"🎉 CIRCUIT COMPLETE!\")\n",
    "    print(\"=\"*50)\n",
    "    print(f\"Circuit name: {circuit.name}\")\n",
    "    print(f\"Components: {len(circuit.components)}\")\n",
    "    print(f\"Nodes: {len(circuit.nodes)}\")\n",
    "    \n",
    "    # Display component details\n",
    "    print(\"\\n📋 Component List:\")\n",
    "    for i, comp in enumerate(circuit.components, 1):\n",
    "        print(f\"  {i}. {comp['name']}: {comp['type']} - {comp.get('dc_value', comp.get('resistance', 'N/A'))}\")\n",
    "    \n",
    "    return circuit\n",
    "\n",
    "# Build the circuit\n",
    "my_circuit = create_guided_circuit_builder()"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Run the Simulation\n",
    "\n",
    "Now let's simulate the circuit and see if your prediction was correct!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Run DC analysis\n",
    "def run_first_simulation(circuit):\n",
    "    print(\"🚀 Starting DC Analysis...\")\n",
    "    print(\"⏳ This may take a few seconds...\")\n",
    "    \n",
    "    # Create simulation engine and run analysis\n",
    "    engine = SimulationEngine()\n",
    "    \n",
    "    try:\n",
    "        results = engine.simulate_dc(circuit)\n",
    "        print(\"✅ Simulation completed successfully!\")\n",
    "        \n",
    "        # Extract results\n",
    "        voltage_at_node_1 = results.voltage(1)[0] if results.voltage(1) else None\n",
    "        current_through_battery = results.current(\"V1\")[0] if results.current(\"V1\") else None\n",
    "        \n",
    "        # Display results with nice formatting\n",
    "        results_html = f\"\"\"\n",
    "        <div style=\"background: #e8f5e8; padding: 20px; border-radius: 10px; border: 3px solid green; margin: 10px 0;\">\n",
    "            <h3>📊 Simulation Results</h3>\n",
    "            <table style=\"width: 100%; font-size: 16px;\">\n",
    "                <tr style=\"background: #f0f8f0;\">\n",
    "                    <td><strong>Measurement</strong></td>\n",
    "                    <td><strong>Value</strong></td>\n",
    "                    <td><strong>Your Prediction</strong></td>\n",
    "                    <td><strong>Match?</strong></td>\n",
    "                </tr>\n",
    "                <tr>\n",
    "                    <td>Voltage at Node 1 (Point A)</td>\n",
    "                    <td><strong>{voltage_at_node_1:.2f}V</strong></td>\n",
    "                    <td>9V</td>\n",
    "                    <td>{'✅ YES!' if abs(voltage_at_node_1 - 9.0) < 0.01 else '❌ No'}</td>\n",
    "                </tr>\n",
    "                <tr style=\"background: #f8f8f8;\">\n",
    "                    <td>Current through circuit</td>\n",
    "                    <td><strong>{abs(current_through_battery)*1000:.1f}mA</strong></td>\n",
    "                    <td>9mA (9V ÷ 1000Ω)</td>\n",
    "                    <td>{'✅ YES!' if abs(abs(current_through_battery) - 0.009) < 0.0001 else '❌ No'}</td>\n",
    "                </tr>\n",
    "            </table>\n",
    "        </div>\n",
    "        \"\"\"\n",
    "        display(HTML(results_html))\n",
    "        \n",
    "        # Power calculation\n",
    "        power_dissipated = abs(current_through_battery) * voltage_at_node_1\n",
    "        print(f\"\\n💡 Bonus Calculation:\")\n",
    "        print(f\"   Power dissipated in resistor: {power_dissipated*1000:.1f}mW\")\n",
    "        print(f\"   (Power = V × I = {voltage_at_node_1:.1f}V × {abs(current_through_battery)*1000:.1f}mA)\")\n",
    "        \n",
    "        return results, voltage_at_node_1, current_through_battery\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Simulation failed: {str(e)}\")\n",
    "        print(\"Don't worry! This happens sometimes. Let's troubleshoot...\")\n",
    "        return None, None, None\n",
    "\n",
    "# Run the simulation\n",
    "results, voltage, current = run_first_simulation(my_circuit)"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Visualize the Results\n",
    "\n",
    "Let's create a visual representation of what we just calculated:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Create visualization of results\n",
    "def visualize_dc_results(voltage, current):\n",
    "    if voltage is None or current is None:\n",
    "        print(\"⚠️ Cannot create visualization - simulation data not available\")\n",
    "        return\n",
    "    \n",
    "    # Create bar chart of voltages\n",
    "    fig = go.Figure()\n",
    "    \n",
    "    # Voltage at each node\n",
    "    nodes = ['Ground (Node 0)', 'Point A (Node 1)']\n",
    "    voltages = [0.0, voltage]\n",
    "    colors = ['gray', 'green']\n",
    "    \n",
    "    fig.add_trace(go.Bar(\n",
    "        x=nodes,\n",
    "        y=voltages,\n",
    "        marker_color=colors,\n",
    "        text=[f'{v:.1f}V' for v in voltages],\n",
    "        textposition='auto',\n",
    "        name='Node Voltages'\n",
    "    ))\n",
    "    \n",
    "    fig.update_layout(\n",
    "        title={\n",
    "            'text': '📊 DC Analysis Results - Node Voltages',\n",
    "            'x': 0.5,\n",
    "            'xanchor': 'center',\n",
    "            'font': {'size': 18}\n",
    "        },\n",
    "        xaxis_title='Circuit Nodes',\n",
    "        yaxis_title='Voltage (V)',\n",
    "        yaxis=dict(range=[0, 10]),\n",
    "        showlegend=False,\n",
    "        height=400,\n",
    "        template='plotly_white'\n",
    "    )\n",
    "    \n",
    "    # Add current information as annotation\n",
    "    fig.add_annotation(\n",
    "        x=0.5, y=8,\n",
    "        text=f'Current through circuit: {abs(current)*1000:.1f}mA',\n",
    "        showarrow=False,\n",
    "        font=dict(size=14, color='blue'),\n",
    "        bgcolor='lightblue',\n",
    "        bordercolor='blue',\n",
    "        borderwidth=1\n",
    "    )\n",
    "    \n",
    "    fig.show()\n",
    "    \n",
    "    # Summary text\n",
    "    summary_html = f\"\"\"\n",
    "    <div style=\"background: #f0f8ff; padding: 15px; border-radius: 10px; margin: 10px 0;\">\n",
    "        <h4>🎯 What This Chart Shows:</h4>\n",
    "        <ul>\n",
    "            <li><strong>Ground (Node 0)</strong>: Always 0V by definition</li>\n",
    "            <li><strong>Point A (Node 1)</strong>: {voltage:.1f}V - exactly what you predicted!</li>\n",
    "            <li><strong>Current Flow</strong>: {abs(current)*1000:.1f}mA flows from battery through resistor to ground</li>\n",
    "        </ul>\n",
    "        <p>✅ <strong>Your prediction was correct!</strong> Point A has the full battery voltage.</p>\n",
    "    </div>\n",
    "    \"\"\"\n",
    "    display(HTML(summary_html))\n",
    "\n",
    "# Create the visualization\n",
    "if voltage is not None and current is not None:\n",
    "    visualize_dc_results(voltage, current)\n",
    "else:\n",
    "    print(\"Skipping visualization due to simulation error\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Interactive Exploration\n",
    "\n",
    "Now let's explore what happens when you change the resistor value:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Interactive parameter exploration\n",
    "def create_interactive_exploration():\n",
    "    # Resistor value slider\n",
    "    resistor_slider = widgets.IntSlider(\n",
    "        value=1000,\n",
    "        min=100,\n",
    "        max=10000,\n",
    "        step=100,\n",
    "        description='Resistor (Ω):',\n",
    "        style={'description_width': '100px'}\n",
    "    )\n",
    "    \n",
    "    # Results display\n",
    "    results_display = widgets.HTML()\n",
    "    \n",
    "    def update_circuit(change):\n",
    "        r_value = resistor_slider.value\n",
    "        \n",
    "        # Create new circuit with different resistor\n",
    "        test_circuit = Circuit(f\"Test Circuit (R={r_value}Ω)\")\n",
    "        test_circuit.add_voltage_source(\"V1\", 1, 0, \"9V\")\n",
    "        test_circuit.add_resistor(\"R1\", 1, 0, str(r_value))\n",
    "        \n",
    "        # Simulate\n",
    "        engine = SimulationEngine()\n",
    "        try:\n",
    "            test_results = engine.simulate_dc(test_circuit)\n",
    "            test_voltage = test_results.voltage(1)[0]\n",
    "            test_current = abs(test_results.current(\"V1\")[0])\n",
    "            test_power = test_voltage * test_current\n",
    "            \n",
    "            results_display.value = f\"\"\"\n",
    "            <div style=\"background: #f8f9fa; padding: 15px; border-radius: 8px; font-family: monospace;\">\n",
    "                <h4>📊 Live Results (R = {r_value}Ω)</h4>\n",
    "                <table style=\"width: 100%;\">\n",
    "                    <tr><td><strong>Voltage at Point A:</strong></td><td>{test_voltage:.2f}V</td></tr>\n",
    "                    <tr><td><strong>Current through circuit:</strong></td><td>{test_current*1000:.1f}mA</td></tr>\n",
    "                    <tr><td><strong>Power dissipated:</strong></td><td>{test_power*1000:.1f}mW</td></tr>\n",
    "                </table>\n",
    "                <p><strong>Key Insight:</strong> Notice that the voltage at Point A is always 9V, \n",
    "                regardless of the resistor value! Only the current changes.</p>\n",
    "            </div>\n",
    "            \"\"\"\n",
    "        except Exception as e:\n",
    "            results_display.value = f\"<p style='color: red;'>Simulation error: {str(e)}</p>\"\n",
    "    \n",
    "    # Set up interactive update\n",
    "    resistor_slider.observe(update_circuit, names='value')\n",
    "    \n",
    "    # Initial calculation\n",
    "    update_circuit(None)\n",
    "    \n",
    "    # Display\n",
    "    exploration_html = HTML(\"\"\"\n",
    "    <div style=\"background: #fff8dc; padding: 15px; border-radius: 10px; margin: 10px 0;\">\n",
    "        <h3>🎛️ Interactive Exploration</h3>\n",
    "        <p>Try changing the resistor value and see what happens to the voltage and current:</p>\n",
    "    </div>\n",
    "    \"\"\")\n",
    "    \n",
    "    display(exploration_html)\n",
    "    display(resistor_slider)\n",
    "    display(results_display)\n",
    "\n",
    "# Create the interactive exploration\n",
    "create_interactive_exploration()"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
