# FastAPI Circuit Simulation - Environment Configuration
# Copy this to .env and customize for your deployment

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery Configuration  
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# Rate Limiting
RATE_LIMIT=100/minute

# WebSocket Configuration
MAX_CONNECTIONS_PER_JOB=10
WEBSOCKET_TIMEOUT=3600

# Simulation Settings
MAX_SIMULATION_TIME=300
MAX_CIRCUIT_COMPONENTS=10000
SIMULATION_TIMEOUT=600

# Database (for future use)
DATABASE_URL=postgresql://user:pass@localhost/circuit_sim

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# Docker Compose Overrides
COMPOSE_PROJECT_NAME=circuit-sim
COMPOSE_FILE=docker-compose.fastapi.yml