{
  "permissions": {
    "allow": [
      "Bash(black *)",
      "Bash(ruff check *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(python examples/*)",
      "Bash(pip install *)",
      "Read(**/*.py)",
      "Write(src/**/*.py)",
      "Write(tests/**/*.py)",
      "Edit(src/**/*.py)",
      "Edit(tests/**/*.py)"
    ],
    "deny": [
      "Read(.env)",
      "Read(secrets/*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(rm -rf /)",
      "Bash(git push --force)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pip uninstall *)",
      "Bash(docker *)",
      "WebFetch"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTEST_ADDOPTS": "-v --tb=short",
    "BLACK_LINE_LENGTH": "88"
  },
  "hooks": {
    "pre_commit": {
      "matchers": ["Edit|Write"],
      "command": "black {file} && ruff check {file}"
    },
    "post_test": {
      "matchers": ["Bash(pytest *)"],
      "command": "echo 'Tests completed. Coverage report available.'"
    }
  }
}